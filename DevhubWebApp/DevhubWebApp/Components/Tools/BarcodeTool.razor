@attribute [Tool(ToolIds.Barcode,
              "Barcode",
              ToolCategories.GeneratorsId,
              "Generate Code 128, EAN, UPC-A and ITF barcodes as SVG.",
              Icons.Material.Filled.ViewWeek,
              Order = 50,
              Keywords = new[] { "code128", "ean", "upc", "itf", "label", "svg" })]

@using DevhubWebApp.Models.Tools.Barcode
@using DevhubWebApp.Utilities
@inherits ToolComponentBase<BarcodeWorkspace>

@* Encoding and SVG rendering live in BarcodeEncoder; this component binds them to the UI. *@

<Toolbar Class="mb-3">
    <ChildContent>
        @foreach (var symbology in BarcodeEncoder.All)
        {
            <Chip Text="@BarcodeEncoder.GetName(symbology)"
                  Color="Color.Primary"
                  Selected="@(Workspace.Symbology == symbology)"
                  OnClick="@(() => Update(w => w.Symbology = symbology))" />
        }
    </ChildContent>

    <EndContent>
        <IconButton Icon="@Icons.Material.Filled.ContentPaste" Tooltip="Paste" OnClick="PasteAsync" />
        <CopyButton Text="@_svg" IconOnly="true" Label="Copy SVG" Disabled="@(!HasSymbol)" />
        <IconButton Icon="@Icons.Material.Filled.Download" Tooltip="Download SVG (Ctrl+S)"
                    Disabled="@(!HasSymbol)" OnClick="DownloadSvgAsync" />
    </EndContent>
</Toolbar>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="5">
        <AppCard Title="Data" Icon="@Icons.Material.Filled.Input"
                 Subtitle="@BarcodeEncoder.GetRequirement(Workspace.Symbology)">
            <ChildContent>
                <MudTextField T="string"
                              Value="@Workspace.Data"
                              ValueChanged="@(value => Update(w => w.Data = value ?? string.Empty))"
                              Immediate="true"
                              DebounceInterval="AppConstants.DebounceMilliseconds"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="devhub-mono-field"
                              Error="@(_symbol.Error is not null)"
                              ErrorText="@_symbol.Error"
                              Placeholder="@GetPlaceholder()"
                              aria-label="Barcode data" />
            </ChildContent>
        </AppCard>

        <AppCard Title="Appearance" Icon="@Icons.Material.Filled.Straighten" Class="mt-3">
            <ChildContent>
                <SettingItem Label="Module width" Description="@($"{Workspace.ModuleWidth} px per module")">
                    <MudSlider T="int" Value="@Workspace.ModuleWidth" ValueChanged="@(v => Update(w => w.ModuleWidth = v))"
                               Min="1" Max="8" Color="Color.Primary" Class="devhub-password__slider" />
                </SettingItem>
                <SettingItem Label="Height" Description="@($"{Workspace.Height} px")">
                    <MudSlider T="int" Value="@Workspace.Height" ValueChanged="@(v => Update(w => w.Height = v))"
                               Min="30" Max="200" Color="Color.Primary" Class="devhub-password__slider" />
                </SettingItem>
                <SettingItem Label="Quiet zone" Description="@($"{Workspace.Margin} px margin")">
                    <MudSlider T="int" Value="@Workspace.Margin" ValueChanged="@(v => Update(w => w.Margin = v))"
                               Min="0" Max="40" Color="Color.Primary" Class="devhub-password__slider" />
                </SettingItem>
                <SettingItem Label="Human-readable text" Description="Print the value beneath the bars.">
                    <MudSwitch T="bool" Value="@Workspace.ShowText" ValueChanged="@(v => Update(w => w.ShowText = v))" Color="Color.Primary" />
                </SettingItem>
                <SettingItem Label="Font size" Description="@($"{Workspace.FontSize} px")" Last="true">
                    <MudSlider T="int" Value="@Workspace.FontSize" ValueChanged="@(v => Update(w => w.FontSize = v))"
                               Min="8" Max="28" Color="Color.Primary" Class="devhub-password__slider" />
                </SettingItem>
            </ChildContent>
        </AppCard>
    </MudItem>

    <MudItem xs="12" lg="7">
        <AppCard Title="Preview" Icon="@Icons.Material.Filled.Preview"
                 Subtitle="@(HasSymbol ? $"{_symbol.Modules.Count} modules" : null)">
            <ChildContent>
                @if (_symbol.Error is not null)
                {
                    <ErrorState Title="That value cannot be encoded"
                                Description="@_symbol.Error"
                                Dense="true"
                                RetryText="@null" />
                }
                else if (!HasSymbol)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.ViewWeek"
                                Title="Nothing to encode yet"
                                Description="Enter a value on the left; the barcode updates as you type."
                                Dense="true" />
                }
                else
                {
                    <div class="devhub-barcode__preview">@((MarkupString)_svg)</div>
                }
            </ChildContent>
        </AppCard>
    </MudItem>
</MudGrid>
