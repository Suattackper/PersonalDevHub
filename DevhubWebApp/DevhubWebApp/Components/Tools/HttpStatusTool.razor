@attribute [Tool(ToolIds.HttpStatus,
              "HTTP Status",
              ToolCategories.WebId,
              "Look up HTTP status codes with their meaning, use cases and example responses.",
              Icons.Material.Filled.Http,
              Order = 20,
              Keywords = new[] { "404", "500", "response", "code", "rfc-9110" })]

@using DevhubWebApp.Models.Tools.Http
@using DevhubWebApp.Constants
@inherits ToolComponentBase<HttpStatusWorkspace>

@* Look-up and example building live in IHttpStatusService; this component binds them to the UI. *@

<CatalogFilterBar TCategory="HttpStatusClass"
                  SearchTerm="@Workspace.Search"
                  SearchTermChanged="OnSearchChangedAsync"
                  Categories="@Statuses.Classes"
                  Selected="@Workspace.Class"
                  SelectedChanged="OnClassChangedAsync"
                  LabelSelector="@HttpStatusCatalog.DescribeClass"
                  IconSelector="@GetClassIcon"
                  Placeholder="@L("Search by code (404) or meaning (rate limited)…")"
                  Class="mb-3" />

<MudGrid Spacing="3">
    <MudItem xs="12" lg="6">
        <AppCard Title="@L("Status codes")" Icon="@Icons.Material.Filled.List" Subtitle="@($"{_results.Count} code(s)")">
            <ChildContent>
                @if (_results.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.SearchOff"
                                Title="@L("No status code matches")"
                                Description="@L("Try a bare number, a reason phrase, or clear the class filter.")"
                                Dense="true" />
                }
                else
                {
                    <div class="devhub-catalog__list">
                        @foreach (var entry in _results)
                        {
                            <button type="button"
                                    class="devhub-catalog__row @(entry.Code == Workspace.SelectedCode ? "devhub-catalog__row--active" : null)"
                                    @key="entry.Code"
                                    @onclick="@(() => SelectAsync(entry))">
                                <div class="devhub-catalog__row-main">
                                    <code>@entry.Title</code>
                                    <span class="devhub-catalog__row-note">@entry.Description</span>
                                </div>
                                <div class="devhub-catalog__row-side">
                                    <Badge Text="@($"{entry.Code / 100}xx")" Color="@GetClassColor(entry.Class)" />
                                </div>
                            </button>
                        }
                    </div>
                }
            </ChildContent>
        </AppCard>
    </MudItem>

    <MudItem xs="12" lg="6">
        @if (_selected is null)
        {
            <AppCard>
                <EmptyState Icon="@Icons.Material.Outlined.Http"
                            Title="@L("Pick a status code")"
                            Description="@L("Select a code to see when to use it, what to send with it, and which codes it is confused with.")"
                            Dense="true" />
            </AppCard>
        }
        else
        {
            <AppCard Title="@_selected.Title" Icon="@GetClassIcon(_selected.Class)"
                     Subtitle="@HttpStatusCatalog.DescribeClass(_selected.Class)">
                <Actions>
                    <IconButton Icon="@(IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                Tooltip="@(IsFavorite ? "Remove from favourites" : "Save to favourites")"
                                Color="@(IsFavorite ? Color.Warning : Color.Default)"
                                OnClick="ToggleFavoriteAsync" />
                    <CopyButton Text="@_selected.Title" IconOnly="true" Label="@L("Copy status")" />
                </Actions>
                <ChildContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_selected.Description</MudText>

                    @if (_selected.UseCases.Count > 0)
                    {
                        <DividerTitle Title="@L("Use it when")" Icon="@Icons.Material.Filled.Checklist" />
                        <MudList T="string" Dense="true">
                            @foreach (var useCase in _selected.UseCases)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.ArrowRight" @key="useCase">
                                    <MudText Typo="Typo.body2">@useCase</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    }

                    <DividerTitle Title="@L("Example response")" Icon="@Icons.Material.Filled.Code" />
                    <pre class="devhub-catalog__snippet">@_example</pre>
                    <CopyButton Text="@_example" Label="@L("Copy example")" Variant="Variant.Outlined" Class="mt-2" />

                    @if (_related.Count > 0)
                    {
                        <DividerTitle Title="@L("Compare with")" Icon="@Icons.Material.Filled.CompareArrows" />
                        <div class="devhub-catalog__chips">
                            @foreach (var related in _related)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" @key="related.Code"
                                           OnClick="@(() => SelectAsync(related))">@related.Title</MudButton>
                            }
                        </div>
                    }
                </ChildContent>
            </AppCard>

            @if (Workspace.Favorites.Count > 0 || Workspace.Recent.Count > 0)
            {
                <AppCard Title="@L("Saved")" Icon="@Icons.Material.Filled.Bookmarks" Class="mt-3">
                    <ChildContent>
                        @if (Workspace.Favorites.Count > 0)
                        {
                            <DividerTitle Title="@L("Favourites")" Icon="@Icons.Material.Filled.Star" />
                            @* Named 'statusCode': Razor would read @key="code" as the @code directive. *@
                            <div class="devhub-catalog__chips">
                                @foreach (var statusCode in Workspace.Favorites)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" @key="statusCode"
                                               OnClick="@(() => SelectByCodeAsync(statusCode))">@statusCode</MudButton>
                                }
                            </div>
                        }

                        @if (Workspace.Recent.Count > 0)
                        {
                            <DividerTitle Title="@L("Recent")" Icon="@Icons.Material.Filled.History" />
                            <div class="devhub-catalog__chips">
                                @foreach (var statusCode in Workspace.Recent)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text" @key="statusCode"
                                               OnClick="@(() => SelectByCodeAsync(statusCode))">@statusCode</MudButton>
                                }
                            </div>
                        }
                    </ChildContent>
                </AppCard>
            }
        }
    </MudItem>
</MudGrid>
