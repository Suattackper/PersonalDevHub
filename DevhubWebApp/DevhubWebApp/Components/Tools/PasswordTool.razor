@attribute [Tool(ToolIds.Password,
              "Password Generator",
              ToolCategories.GeneratorsId,
              "Build strong passwords and passphrases with a live strength meter.",
              Icons.Material.Filled.Password,
              Order = 20,
              Keywords = new[] { "random", "secret", "strength", "entropy", "passphrase" },
              Tags = new[] { "crypto" })]

@using DevhubWebApp.Models.Tools.Password
@using DevhubWebApp.Utilities
@inherits ToolComponentBase<PasswordWorkspace>

@* Generation and strength measurement live in PasswordGenerator; this component binds them. *@

<Toolbar Class="mb-3">
    <ChildContent>
        <MudButton StartIcon="@Icons.Material.Filled.Autorenew"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="GenerateAsync">
            Generate (Ctrl+Enter)
        </MudButton>

        @foreach (var kind in Kinds)
        {
            <Chip Text="@GetKindLabel(kind)"
                  Icon="@GetKindIcon(kind)"
                  Color="Color.Primary"
                  Selected="@(Workspace.Kind == kind)"
                  OnClick="@(() => SetKindAsync(kind))" />
        }
    </ChildContent>

    <EndContent>
        <CopyButton Text="@_current?.Value" IconOnly="true" Disabled="@(_current is null)" />
        <IconButton Icon="@Icons.Material.Filled.Download" Tooltip="@L("Download batch (Ctrl+S)")"
                    Disabled="@(_batch.Count == 0)" OnClick="DownloadAsync" />
    </EndContent>
</Toolbar>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="7">
        <AppCard Title="@L("Generated")" Icon="@Icons.Material.Filled.Key">
            <ChildContent>
                @if (_current is null)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Password"
                                Title="@L("No password generated yet")"
                                Description="@L("Pick your options and generate — nothing is ever sent anywhere.")"
                                ActionText="@L("Generate")"
                                ActionIcon="@Icons.Material.Filled.Autorenew"
                                OnAction="GenerateAsync"
                                Dense="true" />
                }
                else if (string.IsNullOrEmpty(_current.Value))
                {
                    <ErrorState Title="@L("No character set selected")"
                                Description="@L("Enable at least one of uppercase, lowercase, numbers or symbols.")"
                                Dense="true"
                                RetryText="@null" />
                }
                else
                {
                    <div class="devhub-password__value">
                        <code>@_current.Value</code>
                        <CopyButton Text="@_current.Value" IconOnly="true" />
                    </div>

                    <div class="devhub-password__meter mt-3">
                        <div class="devhub-password__meter-head">
                            <MudText Typo="Typo.subtitle2" Style="@StrengthStyle">
                                @PasswordGenerator.GetStrengthLabel(_current.Strength)
                            </MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @(Preferences.Settings.Language == DevhubWebApp.Models.AppLanguage.Vietnamese
                                    ? $"{_current.EntropyBits} bit · tập ký tự {_current.AlphabetSize} · ước tính {_current.CrackTime} để dò"
                                    : $"{_current.EntropyBits} bits · alphabet of {_current.AlphabetSize} · ~{_current.CrackTime} to crack")
                            </MudText>
                        </div>
                        <MudProgressLinear Value="@StrengthPercentage" Color="@StrengthColor" Rounded="true" Size="Size.Medium" />
                    </div>

                    @if (_batch.Count > 1)
                    {
                        <DividerTitle Title="@($"Batch of {_batch.Count}")" Icon="@Icons.Material.Filled.List" />
                        <div class="devhub-password__batch">
                            @foreach (var password in _batch)
                            {
                                <div class="devhub-password__batch-row" @key="password.Value">
                                    <code>@password.Value</code>
                                    <Badge Text="@($"{password.EntropyBits} bits")" />
                                    <CopyButton Text="@password.Value" IconOnly="true" Notify="false" />
                                </div>
                            }
                        </div>
                    }
                }
            </ChildContent>
        </AppCard>

        <AppCard Title="@L("Security tips")" Icon="@Icons.Material.Filled.Shield" Class="mt-3">
            <ChildContent>
                <MudList T="string" Dense="true">
                    @foreach (var tip in SecurityTips)
                    {
                        <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircleOutline" @key="tip">
                            <MudText Typo="Typo.body2">@tip</MudText>
                        </MudListItem>
                    }
                </MudList>
            </ChildContent>
        </AppCard>
    </MudItem>

    <MudItem xs="12" lg="5">
        <AppCard Title="@L("Options")" Icon="@Icons.Material.Filled.Tune">
            <ChildContent>
                @if (Workspace.Kind == PasswordKind.Passphrase)
                {
                    <SettingItem Label="@L("Words")" Description="@L("More words beat more symbols for memorability and strength.")">
                        <MudNumericField T="int" Value="@Workspace.WordCount" ValueChanged="@(value => UpdateAsync(w => w.WordCount = Math.Clamp(value, 3, 12)))"
                                         Min="3" Max="12" Variant="Variant.Outlined" Margin="Margin.Dense" Class="devhub-password__number" />
                    </SettingItem>
                    <SettingItem Label="@L("Separator")" Description="@L("Character placed between words.")">
                        <MudTextField T="string" Value="@Workspace.WordSeparator" ValueChanged="@(value => UpdateAsync(w => w.WordSeparator = value ?? "-"))"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Class="devhub-password__number" />
                    </SettingItem>
                    <SettingItem Label="@L("Capitalise words")" Description="@L("Start each word with an upper-case letter.")">
                        <MudSwitch T="bool" Value="@Workspace.IncludeUppercase" ValueChanged="@(value => UpdateAsync(w => w.IncludeUppercase = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Append a number")" Description="@L("For policies that insist on a digit.")" Last="true">
                        <MudSwitch T="bool" Value="@Workspace.AppendNumber" ValueChanged="@(value => UpdateAsync(w => w.AppendNumber = value))" Color="Color.Primary" />
                    </SettingItem>
                }
                else
                {
                    <SettingItem Label="@L("Length")" Description="@($"{Workspace.Length} characters")">
                        <MudSlider T="int" Value="@Workspace.Length" ValueChanged="@(value => UpdateAsync(w => w.Length = value))"
                                   Min="6" Max="128" Step="1" Color="Color.Primary" Class="devhub-password__slider" />
                    </SettingItem>
                    <SettingItem Label="@L("Uppercase")" Description="@L("A–Z")">
                        <MudSwitch T="bool" Value="@Workspace.IncludeUppercase" ValueChanged="@(value => UpdateAsync(w => w.IncludeUppercase = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Lowercase")" Description="@L("a–z")">
                        <MudSwitch T="bool" Value="@Workspace.IncludeLowercase" ValueChanged="@(value => UpdateAsync(w => w.IncludeLowercase = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Numbers")" Description="@L("0–9")">
                        <MudSwitch T="bool" Value="@Workspace.IncludeDigits" ValueChanged="@(value => UpdateAsync(w => w.IncludeDigits = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Symbols")" Description="@SymbolsDescription">
                        <MudSwitch T="bool" Value="@Workspace.IncludeSymbols" ValueChanged="@(value => UpdateAsync(w => w.IncludeSymbols = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Exclude similar")" Description="@L("Drops I, l, 1, O and 0.")">
                        <MudSwitch T="bool" Value="@Workspace.ExcludeSimilar" ValueChanged="@(value => UpdateAsync(w => w.ExcludeSimilar = value))" Color="Color.Primary" />
                    </SettingItem>
                    <SettingItem Label="@L("Exclude ambiguous")" Description="@L("Drops brackets and quotes that need escaping.")" Last="true">
                        <MudSwitch T="bool" Value="@Workspace.ExcludeAmbiguous" ValueChanged="@(value => UpdateAsync(w => w.ExcludeAmbiguous = value))" Color="Color.Primary" />
                    </SettingItem>
                }
            </ChildContent>
            <Footer>
                <div class="devhub-password__bulk">
                    <MudNumericField T="int" Value="@Workspace.BatchSize" ValueChanged="@(value => UpdateAsync(w => w.BatchSize = Math.Clamp(value, 1, 100)))"
                                     Min="1" Max="100" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     Label="@L("Batch size")" Class="devhub-password__number" />
                    <MudButton StartIcon="@Icons.Material.Filled.PlaylistAdd" Variant="Variant.Outlined" Size="Size.Small" OnClick="GenerateAsync">
                        Generate batch
                    </MudButton>
                </div>
            </Footer>
        </AppCard>
    </MudItem>
</MudGrid>
