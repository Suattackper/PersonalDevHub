@using DevhubWebApp.Models.Tools

@* Body used by tool modules that are declared but not implemented yet. Keeping it in one place
   means the placeholder never has to be copy-pasted into each tool component. *@

<AppCard>
    <EmptyState Icon="@Icons.Material.Outlined.Construction"
                Title="@($"{Context?.Tool.Name ?? "This tool"} is not implemented yet")"
                Description="Its metadata is already live: it appears in navigation, search and the dashboard. The workspace itself ships in a later module."
                Dense="true" />
</AppCard>

@code {
    /// <summary>Cascaded by the tool host; supplies this tool's own metadata.</summary>
    [CascadingParameter] private ToolContext? Context { get; set; }
}
