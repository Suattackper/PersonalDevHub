@attribute [Tool(ToolIds.Uuid,
              "UUID Generator",
              ToolCategories.GeneratorsId,
              "Generate UUIDs in bulk, copy them and keep a local history.",
              Icons.Material.Filled.Fingerprint,
              Order = 10,
              Keywords = new[] { "guid", "identifier", "random", "bulk" },
              Tags = new[] { "rfc-4122", "v4" })]

@using DevhubWebApp.Models.Tools.Uuid
@using DevhubWebApp.Utilities
@inherits ToolComponentBase<UuidWorkspace>

@* Generation and export live in UuidGenerator; this component binds them to the UI. *@

<Toolbar Class="mb-3">
    <ChildContent>
        <MudButton StartIcon="@Icons.Material.Filled.AutoAwesome"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   OnClick="GenerateAsync">
            @L("Generate (Ctrl+Enter)")
        </MudButton>

        <MudNumericField T="int"
                         Value="@Workspace.Quantity"
                         ValueChanged="OnQuantityChangedAsync"
                         Min="1"
                         Max="UuidGenerator.MaxBatchSize"
                         Variant="Variant.Outlined"
                         Margin="Margin.Dense"
                         Class="devhub-uuid__quantity"
                         Label="@L("Quantity")" />

        <MudSelect T="UuidFormat"
                   Value="@Workspace.Format"
                   ValueChanged="OnFormatChangedAsync"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Dense="true"
                   Class="devhub-uuid__format"
                   Label="@L("Format")">
            @foreach (var format in Formats)
            {
                <MudSelectItem T="UuidFormat" Value="@format">@L(UuidGenerator.GetName(format))</MudSelectItem>
            }
        </MudSelect>

        <Chip Text="Auto copy" Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Secondary"
              Selected="@Workspace.AutoCopy" OnClick="@(() => UpdateAsync(w => w.AutoCopy = !w.AutoCopy))" />
    </ChildContent>

    <EndContent>
        <IconButton Icon="@(Workspace.TableView ? Icons.Material.Filled.GridView : Icons.Material.Filled.TableRows)"
                    Tooltip="@(Workspace.TableView ? "Card view" : "Table view")"
                    OnClick="@(() => UpdateAsync(w => w.TableView = !w.TableView))" />
        <CopyButton Text="@_joined" IconOnly="true" Label="@L("Copy all")" Disabled="@(!HasResults)" />

        <MudMenu Icon="@Icons.Material.Filled.Download" Size="Size.Small" AriaLabel="@L("Download")" Dense="true" Disabled="@(!HasResults)">
            <MudMenuItem Icon="@Icons.Material.Filled.Description" OnClick="@(() => DownloadAsync(ExportKind.Text))">@L("Download .txt")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.TableChart" OnClick="@(() => DownloadAsync(ExportKind.Csv))">@L("Download .csv")</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Filled.DataObject" OnClick="@(() => DownloadAsync(ExportKind.Json))">@L("Download .json")</MudMenuItem>
        </MudMenu>
    </EndContent>
</Toolbar>

<MudGrid Spacing="3">
    <MudItem xs="12" lg="8">
        <AppCard Title="@L("Generated")" Icon="@Icons.Material.Filled.Fingerprint"
                 Subtitle="@(HasResults ? $"{_identifiers.Count} identifier(s)" : null)">
            <ChildContent>
                @if (!HasResults)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.Fingerprint"
                                Title="@L("No identifiers yet")"
                                Description="@L("Choose a quantity and format, then generate a batch.")"
                                ActionText="@L("Generate")"
                                ActionIcon="@Icons.Material.Filled.AutoAwesome"
                                OnAction="GenerateAsync"
                                Dense="true" />
                }
                else if (Workspace.TableView)
                {
                    <div class="devhub-uuid__scroll">
                        <MudSimpleTable Dense="true" Hover="true" Striped="false" Bordered="false">
                            <tbody>
                                @* Virtualised: a batch can hold a thousand rows. *@
                                <Virtualize T="string" Items="_identifiers" Context="identifier" OverscanCount="10">
                                    <tr>
                                        <td class="devhub-uuid__value">@identifier</td>
                                        <td class="devhub-uuid__action">
                                            <CopyButton Text="@identifier" IconOnly="true" Notify="false" />
                                        </td>
                                    </tr>
                                </Virtualize>
                            </tbody>
                        </MudSimpleTable>
                    </div>
                }
                else
                {
                    <div class="devhub-uuid__cards">
                        @foreach (var identifier in _identifiers)
                        {
                            <div class="devhub-uuid__card" @key="identifier">
                                <code>@identifier</code>
                                <CopyButton Text="@identifier" IconOnly="true" Notify="false" />
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </AppCard>
    </MudItem>

    <MudItem xs="12" lg="4">
        <AppCard Title="@L("History")" Icon="@Icons.Material.Filled.History"
                 Subtitle="@($"{Workspace.History.Count} kept on this device")">
            <Actions>
                <IconButton Icon="@Icons.Material.Filled.DeleteSweep" Tooltip="@L("Clear history")"
                            Disabled="@(Workspace.History.Count == 0)" OnClick="ClearHistoryAsync" />
            </Actions>
            <ChildContent>
                <SearchBox @bind-Value="_historySearch" Placeholder="@L("Search history…")" />

                @if (FilteredHistory.Count == 0)
                {
                    <EmptyState Icon="@Icons.Material.Outlined.History"
                                Title="@(Workspace.History.Count == 0 ? "No history yet" : "No match")"
                                Description="@(Workspace.History.Count == 0
                                    ? "Generated identifiers are remembered here so you can find one again."
                                    : "No stored identifier contains that text.")"
                                Dense="true" />
                }
                else
                {
                    <div class="devhub-uuid__scroll mt-2">
                        @foreach (var identifier in FilteredHistory)
                        {
                            <div class="devhub-uuid__history-row" @key="identifier">
                                <code>@identifier</code>
                                <CopyButton Text="@identifier" IconOnly="true" Notify="false" />
                            </div>
                        }
                    </div>
                }
            </ChildContent>
        </AppCard>
    </MudItem>
</MudGrid>
