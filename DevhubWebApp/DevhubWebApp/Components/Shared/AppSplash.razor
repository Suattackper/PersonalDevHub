@* Shown while persisted state is being hydrated. Deliberately minimal to avoid layout shift. *@

<div class="devhub-splash">
    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Large" Color="Color.Primary" />
    <MudText Typo="Typo.h6" Class="mt-2">@AppConstants.AppName</MudText>
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="devhub-splash__progress mt-4" />
</div>
