@inherits DashboardSectionBase
@inject IUserPreferenceService UiPreferences

@* Latest recorded actions. Tool name and icon are resolved through the service, so a renamed tool
   updates here without touching stored history. *@

<section class="devhub-dashboard-section">
    <SectionTitle Title="@UiText.Get(UiPreferences.Settings.Language, "Recent history")" Icon="@Icons.Material.Filled.ManageSearch">
        <Actions>
            <MudButton Size="Size.Small" Variant="Variant.Text" Href="@AppRoutes.History">@UiText.Get(UiPreferences.Settings.Language, "See all")</MudButton>
        </Actions>
    </SectionTitle>

    <AppCard Flush="@(!IsLoading && ErrorMessage is null && _entries.Count > 0)">
        @if (IsLoading)
        {
            <LoadingSkeleton Variant="SkeletonVariant.List" Count="4" />
        }
        else if (ErrorMessage is not null)
        {
            <ErrorState Title="@UiText.Get(UiPreferences.Settings.Language, "Could not load history")"
                        Detail="@ErrorMessage"
                        Dense="true"
                        OnRetry="ReloadAsync" />
        }
        else if (_entries.Count == 0)
        {
            <EmptyState Icon="@Icons.Material.Outlined.ManageSearch"
                        Title="@UiText.Get(UiPreferences.Settings.Language, "No activity recorded")"
                        Description="@UiText.Get(UiPreferences.Settings.Language, "Actions you run inside a tool are logged here, on this device only.")"
                        Dense="true" />
        }
        else
        {
            <MudList T="string" Dense="true" Class="devhub-history-list">
                @foreach (var entry in _entries)
                {
                    var tool = DashboardService.ResolveTool(entry.ToolId);
                    <MudListItem T="string"
                                 @key="entry.Id"
                                 Icon="@(tool?.Tool.Icon ?? Icons.Material.Filled.Bolt)"
                                 Href="@(tool?.Route)"
                                 SecondaryText="@entry.Preview">
                        <div class="devhub-history-list__row">
                            <span>@($"{entry.Action} · {tool?.Name ?? entry.ToolId}")</span>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @entry.TimestampUtc.ToRelativeLabel(UiPreferences.Settings.Language)
                            </MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
        }
    </AppCard>
</section>
