@page "/history"

<PageTitle>History · @AppConstants.AppName</PageTitle>

<PageHeader Title="History"
            Subtitle="Everything you ran, stored locally on this device."
            Icon="@Icons.Material.Filled.History" />

<EmptyState Icon="@Icons.Material.Outlined.History"
            Title="No activity recorded yet"
            Description="Tool actions appear here once the tool modules start recording them."
            ActionText="Back to dashboard"
            ActionHref="@AppRoutes.Dashboard" />
