@page "/tools/{ToolId}"
@using DevhubWebApp.Models.Tools
@implements IDisposable

@* Single route for every tool. The host resolves metadata from the registry and renders the
   discovered component dynamically — adding a tool never touches this file. *@

@if (_view is null)
{
    <PageTitle>@AppConstants.AppName</PageTitle>

    <EmptyState Icon="@Icons.Material.Outlined.SearchOff"
                Title="Unknown tool"
                Description="@($"There is no tool registered with the id “{ToolId}”.")"
                ActionText="Back to dashboard"
                ActionHref="@AppRoutes.Dashboard" />
}
else
{
    <PageTitle>@UiText.Get(Preferences.Settings.Language, _view.Name) · @AppConstants.AppName</PageTitle>

    <PageHeader Title="@UiText.Get(Preferences.Settings.Language, _view.Name)" Subtitle="@UiText.Get(Preferences.Settings.Language, _view.Tool.Description)" Icon="@_view.Tool.Icon" IconColor="@_view.Tool.Color">
        <MetaContent>
            <Badge Text="@UiText.Get(Preferences.Settings.Language, _view.Tool.Category.Label)" Icon="@_view.Tool.Category.Icon" />
            <Badge Text="@($"v{_view.Tool.Version}")" />
            @if (_view.Tool.IsExperimental)
            {
                <Badge Text="Experimental" Icon="@Icons.Material.Filled.Science" Color="Color.Warning" />
            }
            @foreach (var tag in _view.Tool.Tags)
            {
                <Badge Text="@tag" />
            }
        </MetaContent>
        <Actions>
            <MudButton StartIcon="@Icons.Material.Filled.HelpOutline" Variant="Variant.Outlined" OnClick="ToggleGuide">@UiText.Get(Preferences.Settings.Language, "Guide")</MudButton>
            <IconButton Icon="@(_view.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                        Tooltip="@UiText.Get(Preferences.Settings.Language, _view.IsFavorite ? "Remove from favorites" : "Add to favorites")"
                        Color="@(_view.IsFavorite ? Color.Warning : Color.Default)"
                        OnClick="ToggleFavoriteAsync" />
            <IconButton Icon="@(_view.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                        Tooltip="@UiText.Get(Preferences.Settings.Language, _view.IsPinned ? "Unpin from sidebar" : "Pin to sidebar")"
                        Color="@(_view.IsPinned ? Color.Primary : Color.Default)"
                        OnClick="TogglePinAsync" />
        </Actions>
    </PageHeader>

    @if (_showGuide)
    {
        var guide = ToolGuideDetails.For(_view.Id, Preferences.Settings.Language);
        <MudAlert Severity="Severity.Info" Class="mb-4" CloseIcon="@Icons.Material.Filled.Close" ShowCloseIcon="true" CloseIconClicked="ToggleGuide">
            <strong>@(Preferences.Settings.Language == AppLanguage.Vietnamese ? "Cách sử dụng" : "How to use") @UiText.Get(Preferences.Settings.Language, _view.Name)</strong>
            <ol class="mt-2 mb-2">
                @foreach (var step in guide.Steps)
                {
                    <li>@step</li>
                }
            </ol>
            <div><strong>@(Preferences.Settings.Language == AppLanguage.Vietnamese ? "Ví dụ" : "Example"):</strong> @guide.Example</div>
            <div class="mt-2"><strong>@(Preferences.Settings.Language == AppLanguage.Vietnamese ? "Lưu ý" : "Note"):</strong> @guide.Note</div>
        </MudAlert>
    }

    <CascadingValue Value="_context" IsFixed="false">
        <DynamicComponent Type="_view.Tool.ComponentType" />
    </CascadingValue>
}
