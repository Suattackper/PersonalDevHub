@page "/settings"

<PageTitle>Settings · @AppConstants.AppName</PageTitle>

<PageHeader Title="Settings"
            Subtitle="Theme, language, defaults and local data."
            Icon="@Icons.Material.Filled.Settings" />

<EmptyState Icon="@Icons.Material.Outlined.Tune"
            Title="Settings module arrives later"
            Description="Theme switching already works from the top bar and is persisted. The full settings surface (language, default tool, export/import, reset) is its own module."
            ActionText="Back to dashboard"
            ActionHref="@AppRoutes.Dashboard" />
