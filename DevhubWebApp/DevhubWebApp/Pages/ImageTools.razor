@page "/image-tools"
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IUserPreferenceService Preferences

<PageTitle>@(Vietnamese ? "Công cụ ảnh" : "Image tools") · DevHub</PageTitle>
<PageHeader Title="@UiText.Get(Preferences.Settings.Language, "Image tools")"
            Subtitle="@(Vietnamese ? "Lấy mã màu, xóa nền đồng màu và xuất PNG ngay trên thiết bị." : "Pick colours, remove uniform backgrounds and export PNG on your device.")"
            Icon="@Icons.Material.Filled.Image" />

<details class="devhub-image__guide">
    <summary>@(Vietnamese ? "Hướng dẫn sử dụng" : "How to use")</summary>
    <ol>
        <li>@(Vietnamese ? "Kéo thả, chọn tệp hoặc nhấn Ctrl+V để đưa ảnh vào." : "Drop, browse or press Ctrl+V to load an image.")</li>
        <li>@(Vietnamese ? "Chọn chế độ lấy màu rồi nhấp ảnh để xem HEX và RGB." : "Choose colour picking and click the image for HEX and RGB.")</li>
        <li>@(Vietnamese ? "Chọn chế độ lấy mẫu nền, nhấp vùng nền, chỉnh ngưỡng rồi bấm Xóa nền." : "Sample a background pixel, adjust tolerance and select Remove background.")</li>
        <li>@(Vietnamese ? "So sánh, khôi phục hoặc tải kết quả PNG." : "Compare, restore or download the PNG result.")</li>
    </ol>
</details>

<div id="image-tools-workspace" class="devhub-image" data-language="@(Vietnamese ? "vi" : "en")">
    <input class="devhub-image__file" type="file" accept="image/png,image/jpeg,image/webp,image/gif" aria-label="@(Vietnamese ? "Chọn ảnh" : "Choose image")" />
    <div class="devhub-image__drop" tabindex="0" role="button" aria-label="@(Vietnamese ? "Chọn hoặc thả ảnh" : "Choose or drop an image")">
        <div class="devhub-image__drop-content">
            <MudIcon Icon="@Icons.Material.Filled.AddPhotoAlternate" Size="Size.Large" Color="Color.Primary" />
            <strong>@(Vietnamese ? "Kéo thả ảnh vào đây" : "Drop an image here")</strong>
            <span>@(Vietnamese ? "hoặc nhấp để chọn tệp · Ctrl+V để dán ảnh" : "or click to browse · Ctrl+V to paste an image")</span>
            <small>PNG · JPEG · WebP · GIF · @(Vietnamese ? "tối đa" : "up to") 20 MB</small>
        </div>
    </div>

    <div class="devhub-image__workspace" hidden>
        <div class="devhub-image__toolbar">
            <div class="devhub-image__meta" aria-live="polite"></div>
            <div class="devhub-image__actions">
                <button type="button" class="devhub-image__replace">@(Vietnamese ? "Thay ảnh" : "Replace image")</button>
                <button type="button" class="devhub-image__restore">@(Vietnamese ? "Khôi phục" : "Restore")</button>
                <button type="button" class="devhub-image__download">@(Vietnamese ? "Tải PNG" : "Download PNG")</button>
            </div>
        </div>

        <div class="devhub-image__preview">
            <canvas class="devhub-image__canvas" aria-label="@(Vietnamese ? "Ảnh đang chỉnh sửa" : "Image being edited")"></canvas>
        </div>

        <div class="devhub-image__controls">
            <section class="devhub-image__control">
                <h2>@(Vietnamese ? "Lấy mã màu" : "Pick a colour")</h2>
                <p>@(Vietnamese ? "Chọn chế độ rồi nhấp vào ảnh để lấy mã màu của điểm ảnh." : "Select this mode and click the image to sample a pixel.")</p>
                <button type="button" class="devhub-image__mode-pick" aria-pressed="true">@(Vietnamese ? "Chọn màu trên ảnh" : "Pick colour on image")</button>
                <div class="devhub-image__colour-result">
                    <span class="devhub-image__swatch" aria-hidden="true"></span>
                    <output class="devhub-image__hex">—</output>
                    <output class="devhub-image__rgb"></output>
                    <button type="button" class="devhub-image__copy" disabled>@(Vietnamese ? "Sao chép HEX" : "Copy HEX")</button>
                </div>
            </section>
            <section class="devhub-image__control">
                <h2>@(Vietnamese ? "Xóa nền đồng màu" : "Remove a uniform background")</h2>
                <p>@(Vietnamese ? "Chọn một điểm trên nền, chỉnh ngưỡng rồi xóa vùng màu liền kề." : "Sample a background pixel, adjust tolerance and remove the connected colour region.")</p>
                <button type="button" class="devhub-image__mode-background" aria-pressed="false">@(Vietnamese ? "Chọn màu nền trên ảnh" : "Sample background on image")</button>
                <div class="devhub-image__background-sample"><span class="devhub-image__background-swatch"></span><output class="devhub-image__background-hex">—</output></div>
                <label class="devhub-image__tolerance-label">@(Vietnamese ? "Ngưỡng tương đồng" : "Colour tolerance") <output class="devhub-image__tolerance-value">25</output>
                    <input class="devhub-image__tolerance" type="range" min="0" max="100" value="25" />
                </label>
                <button type="button" class="devhub-image__remove">@(Vietnamese ? "Xóa nền" : "Remove background")</button>
                <label class="devhub-image__compare-label"><input class="devhub-image__compare" type="checkbox" /> @(Vietnamese ? "Xem ảnh gốc" : "Show original")</label>
            </section>
        </div>
    </div>

    <p class="devhub-image__status" role="status" aria-live="polite"></p>
</div>

@code {
    private IJSObjectReference? _module;
    private bool Vietnamese => Preferences.Settings.Language == AppLanguage.Vietnamese;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/image-tools.js");
        await _module.InvokeVoidAsync("initialize", "image-tools-workspace");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", "image-tools-workspace");
            await _module.DisposeAsync();
        }
    }
}
