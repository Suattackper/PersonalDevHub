@page "/"
@using DevhubWebApp.Components.Dashboard
@inject IUserPreferenceService Preferences

@* Composition only. The page holds no state and subscribes to nothing, so it renders once; each
   section below owns its data, its loading/error state and its own re-renders. *@

<PageTitle>@AppConstants.AppName</PageTitle>

<PageHeader Title="@UiText.Get(Preferences.Settings.Language, "Dashboard")"
            Subtitle="@UiText.Get(Preferences.Settings.Language, AppConstants.AppTagline)"
            Icon="@Icons.Material.Filled.SpaceDashboard">
    <Actions>
        <MudButton StartIcon="@Icons.Material.Filled.History" Href="@AppRoutes.History" Variant="Variant.Text">
            @UiText.Get(Preferences.Settings.Language, "History")
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Settings" Href="@AppRoutes.Settings" Variant="Variant.Text">
            @UiText.Get(Preferences.Settings.Language, "Settings")
        </MudButton>
    </Actions>
</PageHeader>

<StatisticsPanel />

<QuickSearchPanel />

<ToolSection Title="@UiText.Get(Preferences.Settings.Language, "Pinned")"
             Icon="@Icons.Material.Filled.PushPin"
             Loader="LoadPinnedAsync"
             EmptyIcon="@Icons.Material.Outlined.PushPin"
             EmptyTitle="@UiText.Get(Preferences.Settings.Language, "No pinned tools")"
             EmptyDescription="@UiText.Get(Preferences.Settings.Language, "Pin a tool to keep it in the sidebar on every page.")" />

<ToolSection Title="@UiText.Get(Preferences.Settings.Language, "Favorites")"
             Icon="@Icons.Material.Filled.Star"
             Loader="LoadFavoritesAsync"
             EmptyIcon="@Icons.Material.Outlined.StarBorder"
             EmptyTitle="@UiText.Get(Preferences.Settings.Language, "No favorites yet")"
             EmptyDescription="@UiText.Get(Preferences.Settings.Language, "Star the tools you reach for most and they will appear here.")" />

<ToolSection Title="@UiText.Get(Preferences.Settings.Language, "Recent tools")"
             Icon="@Icons.Material.Filled.Schedule"
             Loader="LoadRecentAsync"
             EmptyIcon="@Icons.Material.Outlined.Schedule"
             EmptyTitle="@UiText.Get(Preferences.Settings.Language, "No tool opened yet")"
             EmptyDescription="@UiText.Get(Preferences.Settings.Language, "Tools you open appear here so you can jump straight back in.")" />

<ToolSection Title="@UiText.Get(Preferences.Settings.Language, "Most used")"
             Icon="@Icons.Material.Filled.TrendingUp"
             Loader="LoadMostUsedAsync"
             EmptyIcon="@Icons.Material.Outlined.TrendingUp"
             EmptyTitle="@UiText.Get(Preferences.Settings.Language, "No usage recorded")"
             EmptyDescription="@UiText.Get(Preferences.Settings.Language, "Open a tool a few times and your top tools will be ranked here.")" />

<HistoryPanel />
