root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,js,css,html,webmanifest,yml,yaml}]
indent_size = 4

[*.{razor,cshtml}]
indent_size = 4

[*.cs]
# --- language style -------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning

# --- analyzers ------------------------------------------------------------
# CA1716: "Shared"/"Error" are established Blazor and UI vocabulary; renaming them
# would cost more in readability than the cross-language concern is worth here.
dotnet_diagnostic.CA1716.severity = none
# CA1848: LoggerMessage source generators are aimed at hot server paths. DevHub logs
# only on rare storage corruption, in a single-threaded WASM client.
dotnet_diagnostic.CA1848.severity = none
# CA1816: Blazor components implement IDisposable to unsubscribe events. They are
# sealed-by-convention render fragments with no finalizers, so SuppressFinalize is noise.
dotnet_diagnostic.CA1816.severity = none
# CA1515: this is an application, not a library; public types are the norm.
dotnet_diagnostic.CA1515.severity = none
